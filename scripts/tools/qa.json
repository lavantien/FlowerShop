{
	"memguard": {
		"capBytes": 4294967296,
		"processNames": ["java.exe", "node.exe", "chrome.exe", "chromium.exe", "headless_shell.exe"],
		"includePatterns": ["flowershop", "vitest", "esbuild", "playwright", "ms-playwright"],
		"excludePatterns": ["claude"]
	},
	"fuzz": {
		"seed": 20261007,
		"port": 8199,
		"paymentSecret": "dev-only-secret",
		"bootTimeoutMs": 120000,
		"requestTimeoutMs": 10000,
		"runBudgetMs": 420000,
		"generatedVariantsPerEndpoint": 6,
		"stockTopUpQuantity": 500,
		"corpusPath": "scripts/tools/fuzz-corpus.json",
		"reportPath": "docs/qa/fuzz-report.md",
		"serverLogPath": ".tools/fuzz-server.log"
	},
	"mutate": {
		"mapPath": "scripts/tools/mutation-map.json",
		"reportPath": "docs/qa/mutation-report.md",
		"logPath": ".tools/mutate-run.log",
		"perMutantTimeoutMs": 420000,
		"mavenArgs": ["-Dfrontend.skip=true", "-Djacoco.skip=true", "-DfailIfNoTests=false"],
		"mavenOpts": "-Xmx512m -XX:+UseSerialGC -XX:MaxMetaspaceSize=256m -XX:ReservedCodeCacheSize=64m -XX:-UsePerfData"
	},
	"mutate-front": {
		"mapPath": "scripts/tools/mutation-front-map.json",
		"reportPath": "docs/qa/mutation-front-report.md",
		"logPath": ".tools/mutate-front-run.log",
		"perMutantTimeoutMs": 240000,
		"frontendDir": "frontend"
	}
}
